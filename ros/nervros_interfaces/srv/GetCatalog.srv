# Describe the skills this robot offers to missions.
---
# JSON: skills with their args (type, enum, unit, default), requires, effects, resources,
# idempotent, risk, max_duration_s, and a template for the approval text.
string catalog_json
# BehaviorTree.CPP's TreeNodesModel XML for every node a mission may use.
string tree_nodes_model_xml
string bt_cpp_version
# Changes whenever the catalog or the node model changes.
string catalog_version
