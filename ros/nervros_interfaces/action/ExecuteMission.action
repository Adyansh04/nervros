# Run one behaviour tree that the agent compiled, validated and had approved.
# The executor runs one mission at a time and rejects a second goal while one is active.

# Client-chosen id, echoed in feedback and in the result.
string mission_id
# A complete BehaviorTree.CPP v4 document with main_tree_to_execute set.
string tree_xml
# SHA-256 (hex) of tree_xml as approved. The executor recomputes it and rejects a mismatch.
string tree_sha256
# Watchdog in seconds. 0 means the executor's default; larger values are clamped to its cap.
float32 max_duration_s
# Deadman: seconds the mission may go without a Heartbeat on the executor's ~/heartbeat topic
# before it is stopped as StopAll stops it (halt, cancel, hold; a hand keeps its grip). The clock
# starts when the goal is accepted. 0 turns the deadman off, for a script with a person watching.
# The executor caps it at its own maximum.
float32 heartbeat_timeout_s
# The `client` of the heartbeats that keep this mission alive; another client's do not.
string heartbeat_client

uint8 MODE_EXECUTE=0
uint8 MODE_VALIDATE=1
uint8 MODE_DRY_RUN=2
# EXECUTE runs the tree; VALIDATE only loads and checks it; DRY_RUN ticks it with mock leaves.
uint8 mode
---
uint8 OUTCOME_SUCCESS=0
uint8 OUTCOME_FAILURE=1
uint8 OUTCOME_CANCELED=2
uint8 OUTCOME_TIMEOUT=3
uint8 OUTCOME_REJECTED=4
uint8 OUTCOME_ERROR=5
uint8 outcome
# Path of the leaf that failed last before the tree failed, or of the Timeout that ran out.
# After a cancel, a stop, the watchdog or a shutdown: the name of the step that was running.
# Empty on success.
string failed_node
# The step id the failed node belongs to, such as "s2", taken from its "s<N>_" name prefix.
string failed_step_id
# The skill server's own words for the failure. For people and models, not for parsing.
string failure_reason
# For REJECTED: a JSON array of {code, line, node, message}.
string diagnostics_json
# Wall time from goal acceptance to the result.
float32 elapsed_s
---
float32 elapsed_s
# Paths of the nodes that are RUNNING now.
string[] running_nodes
# Status transitions since the previous feedback message.
NodeEvent[] events
