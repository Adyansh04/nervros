{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Find objects by name.",
  "properties": {
    "max_results": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
    },
    "query": {
      "type": "string"
    },
    "room": {
      "description": "Room id or name to search in; empty searches everywhere.",
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "type": "object"
}
